# End-to-end CI under Mesa/Xvfb: real OW terrain -> GPU -> pixel readback.
# craft.test.framebuffer is provided ONLY by the test-only RuntimeExtension.
import "GpuTerrainScene.ow"

main:
  set game: new GpuTerrainScene()
  call: assert(game.start() == 1)
  set original int: game.block_at(0, 5, 0)
  call: assert(original == 1, "known seeded surface exists")
  set before int: game.render()
  call: assert(before >= 1, "at least one real GPU chunk mesh drawn")
  set pixels: extension("craft.test.framebuffer")
  call: assert(pixels[0] >= 4, "terrain must appear in framebuffer")
  call: assert(pixels[1] >= 2, "green grass surface must be visible")

  # In-memory world modification regenerates affected GPU mesh handles.
  call: assert(game.edit_block(0, 5, 0, 4) == 1)
  call: assert(game.block_at(0, 12, 0) == 4)
  set after int: game.render()
  call: assert(after >= 1, "changed terrain mesh still renders")
  set edited: extension("craft.test.framebuffer")
  call: assert(edited[0] >= 4, "edited terrain remains visible")
  call: assert(game.stop() == 1, "GPU resources cleaned before closing context")
  print: "PASS: OWCraft terrain chunks rendered by real OpenGL and pixel sampled"
