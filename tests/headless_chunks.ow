# Direct chunk-local validation and dense 4096-slot indexing.
import "../src/craft/world/Chunk.ow"

main:
  set chunk: new Chunk(0, 0, 0)
  call: assert(chunk.coordinates()[0] == 0)
  call: assert(chunk.local_index(0, 0, 0) == 0)
  call: assert(chunk.local_index(15, 0, 0) == 15)
  call: assert(chunk.local_index(0, 0, 1) == 16)
  call: assert(chunk.local_index(0, 1, 0) == 256)
  call: assert(chunk.local_index(15, 15, 15) == 4095)
  call: assert(chunk.local_index(16, 0, 0) == 0 - 1)
  call: assert(chunk.local_index(0, 0 - 1, 0) == 0 - 1)
  call: assert(chunk.get_block(16, 0, 0) == 0 - 1)
  call: assert(chunk.get_block(2, 5, 3) == 0, "new chunk is air")
  call: assert(chunk.occupied_count() == 0)
  call: assert(chunk.version() == 0)
  call: assert(chunk.set_block(2, 5, 3, 1) == 1)
  call: assert(chunk.get_block(2, 5, 3) == 1)
  call: assert(chunk.version() == 1)
  call: assert(chunk.occupied_count() == 1)
  call: assert(chunk.set_block(2, 5, 3, 1) == 1, "same material is a no-op")
  call: assert(chunk.version() == 1)
  call: assert(chunk.set_block(2, 5, 3, 2) == 1)
  call: assert(chunk.occupied_count() == 1, "replacement preserves occupancy")
  call: assert(chunk.version() == 2)
  call: assert(chunk.set_block(15, 15, 15, 3) == 1)
  call: assert(chunk.get_block(15, 15, 15) == 3)
  call: assert(chunk.occupied_count() == 2)
  call: assert(chunk.set_block(2, 5, 3, 0) == 1)
  call: assert(chunk.occupied_count() == 1)
  call: assert(chunk.set_block(0, 0, 0, 64) == 0)
  call: assert(chunk.set_block(0, 0, 0, 0 - 1) == 0)
  call: assert(chunk.set_block(0, 16, 0, 2) == 0)
  print: "PASS: dense 16x16x16 chunk storage, occupancy and revisions"
