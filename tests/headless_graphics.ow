# Actual OWCraft -> OW Engine ECS -> OW Graphics headless rendering.
# No copied engine code, no OpenGL/GLFW libraries required.
import "@flow/src/App.ow"
import "@engine/src/engine/modules/EngineEntitiesModule.ow"
import "@engine/src/engine/modules/EngineScenesModule.ow"
import "@engine/src/engine/modules/EngineComponentsModule.ow"
import "@engine/src/engine/modules/EngineRenderModule.ow"
import "@graphics/src/graphics/math/api/TransformApi.ow"
import "@graphics/src/graphics/math/infra/Transforms.ow"
import "@graphics/src/graphics/camera/api/CameraApi.ow"
import "@graphics/src/graphics/camera/infra/Camera.ow"
import "@graphics/src/graphics/renderer/api/RendererApi.ow"
import "@graphics/src/graphics/renderer/headless/HeadlessRenderer.ow"
import "@graphics/src/graphics/shader/api/ShaderApi.ow"
import "@graphics/src/graphics/shader/headless/HeadlessShader.ow"
import "@graphics/src/graphics/scene/api/MultiSceneApi.ow"
import "@graphics/src/graphics/scene/infra/MakeMultiScene.ow"

main:
  set entities: new EngineEntitiesModule()
  set scenes: new EngineScenesModule(entities.store())
  set components: new EngineComponentsModule(entities.store())
  set drawing GRAPHICS_MULTI_SCENE: MakeMultiScene(Graphics.HeadlessRenderer)
  set render: new EngineRenderModule(scenes.store(), components.store(), Graphics.Transforms, drawing, Graphics.HeadlessShader)
  set app: new App()
  call: app.use(render)
  call: app.use_native_as(drawing, "GRAPHICS_MULTI_SCENE")
  call: app.use_native_as(Graphics.HeadlessRenderer, "GRAPHICS_RENDERER")
  call: app.use_native_as(Graphics.HeadlessShader, "GRAPHICS_SHADER")
  call: app.use_native_as(Graphics.Transforms, "GRAPHICS_TRANSFORM")
  call: app.use_native_as(Graphics.Camera, "GRAPHICS_CAMERA")
  call: app.use(components)
  call: app.use(scenes)
  call: app.use(entities)
  call: assert(app.boot() == 1, "three repositories compose under flOW")

  set world: app.service("scenes")
  set registry: app.service("components")
  set painter: app.service("render_world")
  set camera GRAPHICS_CAMERA: app.service("camera")
  set shader GRAPHICS_SHADER: app.service("shader")
  call: assert(world.attach_components(registry) == 1)
  call: assert(world.add_scene("overworld") == 1)
  set block int: world.spawn("preview-block")
  call: assert(block > 0)
  call: assert(registry.set_transform(block, 0.0, 0.0, 0.0) == 1)
  call: assert(painter.set_mesh(block, 1) == 1, "opaque mock GPU handle")
  set program int: shader.create("vertex", "fragment")
  set view: camera.view_from_position(0.0, 0.0, 5.0)
  set projection: camera.perspective(1.0471975512, 1.3, 0.1, 100.0)
  call: assert(painter.render_frame(program, view, projection, 15, 25, 40) == 1)
  call: assert(painter.last_draw_count() == 1)
  call: assert(world.destroy(block) == 1)
  call: assert(painter.render_frame(program, view, projection, 15, 25, 40) == 0)
  call: assert(shader.destroy(program) == 1)
  call: assert(app.stop() == 1)
  print: "PASS: OWCraft integration: OW Engine + OW Graphics + flOW"
