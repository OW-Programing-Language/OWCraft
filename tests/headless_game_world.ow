# World service must be registered by flOW in real OWCraft.
import "../src/craft/CraftGame.ow"

main:
  set game: new CraftGame()
  call: assert(game.place_block(0, 0, 0, 1) == 0)
  call: assert(game.get_block(0, 0, 0) == 0 - 1)
  call: assert(game.start() == 1)
  set world: game.world_store()
  call: assert(world.chunk_count() == 0)
  call: assert(game.place_block(0, 0, 0, game.block_catalog().id_of("grass")) == 1)
  call: assert(game.place_block(16, 0, 0, game.block_catalog().id_of("stone")) == 1)
  call: assert(game.place_block(0 - 1, 0, 0, game.block_catalog().id_of("dirt")) == 1)
  call: assert(world.chunk_count() == 3)
  call: assert(world.occupied_blocks() == 3)
  call: assert(game.get_block(0, 0, 0) == 1)
  call: assert(game.get_block(16, 0, 0) == 3)
  call: assert(game.get_block(0 - 1, 0, 0) == 2)
  call: assert(game.break_block(0 - 1, 0, 0) == 1)
  call: assert(game.get_block(0 - 1, 0, 0) == 0)
  call: assert(world.occupied_blocks() == 2)
  call: assert(game.tick(32) == 2)
  call: assert(game.scene_name() == "overworld")
  call: assert(game.stop() == 1)
  print: "PASS: OWCraft world service through flOW and OW Engine"
