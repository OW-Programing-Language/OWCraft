# Neighboring chunks must cull boundary faces on X/Y/Z, including negatives.
import "../src/craft/blocks/BlockCatalog.ow"
import "../src/craft/world/WorldStore.ow"
import "../src/craft/render/ChunkMesher.ow"

main:
  set catalog: new BlockCatalog()
  set world: new WorldStore(catalog)
  set mesher: new ChunkMesher(world, catalog)
  call: assert(world.place_block(15, 1, 1, 3) == 1)
  call: assert(world.place_block(16, 1, 1, 3) == 1)
  call: assert(mesher.count_faces(0, 0, 0) == 5)
  call: assert(mesher.count_faces(1, 0, 0) == 5)
  call: assert(world.break_block(16, 1, 1) == 1)
  call: assert(mesher.count_faces(0, 0, 0) == 6, "neighbor revision must trigger remesh")

  call: assert(world.place_block(0 - 1, 0, 0, 3) == 1)
  call: assert(world.place_block(0, 0, 0, 3) == 1)
  call: assert(mesher.count_faces(0 - 1, 0, 0) == 5, "negative X boundary")
  call: assert(world.place_block(0, 15, 0, 3) == 1)
  call: assert(world.place_block(0, 16, 0, 3) == 1)
  call: assert(mesher.count_faces(0, 1, 0) == 5, "Y chunk boundary")
  call: assert(world.place_block(0, 0, 0 - 1, 3) == 1)
  call: assert(mesher.count_faces(0, 0, 0 - 1) == 5, "negative Z boundary")

  # Verify correct rebuilt geometry; no ECS entity for each individual block.
  set rebuilt: mesher.build(0 - 1, 0, 0)
  call: assert(rebuilt.face_total() == 5)
  call: assert(rebuilt.positions[0] == 0.0 - 1.0, "culled +X face leaves -X world-coordinate face")
  print: "PASS: cross-chunk face culling and signed boundaries"
