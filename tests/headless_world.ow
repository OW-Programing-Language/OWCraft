# Signed world coordinates, boundaries, block edits and chunk lifecycle.
import "../src/craft/blocks/BlockCatalog.ow"
import "../src/craft/world/WorldStore.ow"

main:
  set blocks: new BlockCatalog()
  set world: new WorldStore(blocks)
  call: assert(world.max_chunks() == 32)
  call: assert(world.chunk_count() == 0)
  call: assert(world.chunk_coordinate(0) == 0)
  call: assert(world.chunk_coordinate(15) == 0)
  call: assert(world.chunk_coordinate(16) == 1)
  call: assert(world.chunk_coordinate(31) == 1)
  call: assert(world.chunk_coordinate(0 - 1) == 0 - 1)
  call: assert(world.chunk_coordinate(0 - 16) == 0 - 1)
  call: assert(world.chunk_coordinate(0 - 17) == 0 - 2)
  call: assert(world.chunk_coordinate(0 - 32) == 0 - 2)
  call: assert(world.local_coordinate(0 - 1) == 15)
  call: assert(world.local_coordinate(0 - 16) == 0)
  call: assert(world.local_coordinate(0 - 17) == 15)
  call: assert(world.local_coordinate(0 - 33) == 15)
  call: assert(world.get_block(0, 0, 0) == 0 - 1, "unloaded is not air")
  call: assert(world.break_block(0, 0, 0) == 0)
  call: assert(world.chunk_count() == 0)

  call: assert(world.place_block(15, 15, 15, 1) == 1)
  call: assert(world.place_block(16, 15, 15, 2) == 1)
  call: assert(world.place_block(0 - 1, 15, 15, 3) == 1)
  call: assert(world.place_block(15, 16, 15, 4) == 1)
  call: assert(world.place_block(15, 15, 0 - 1, 5) == 1)
  call: assert(world.place_block(0 - 16, 0 - 16, 0 - 16, 1) == 1)
  call: assert(world.chunk_count() == 6)
  call: assert(world.occupied_blocks() == 6)
  call: assert(world.get_block(15, 15, 15) == 1)
  call: assert(world.get_block(16, 15, 15) == 2)
  call: assert(world.get_block(0 - 1, 15, 15) == 3)
  call: assert(world.get_block(15, 16, 15) == 4)
  call: assert(world.get_block(15, 15, 0 - 1) == 5)
  call: assert(world.get_block(0 - 16, 0 - 16, 0 - 16) == 1)
  call: assert(world.get_block(14, 15, 15) == 0, "loaded air is ID 0")
  call: assert(world.place_block(15, 15, 15, 1) == 1)
  call: assert(world.occupied_blocks() == 6)
  call: assert(world.place_block(15, 15, 15, 3) == 1)
  call: assert(world.occupied_blocks() == 6)

  call: assert(world.place_block(0, 0, 0, 0) == 0)
  call: assert(world.place_block(0, 0, 0, 99) == 0)
  call: assert(world.place_block(1048576, 0, 0, 1) == 0)
  call: assert(world.place_block(0 - 1048577, 0, 0, 1) == 0)
  call: assert(world.get_block(1048576, 0, 0) == 0 - 1)
  call: assert(world.chunk_count() == 6)
  call: assert(world.break_block(15, 15, 15) == 1)
  call: assert(world.get_block(15, 15, 15) == 0)
  call: assert(world.break_block(15, 15, 15) == 0)
  call: assert(world.occupied_blocks() == 5)

  call: assert(world.remove_chunk(1, 0, 0) == 1)
  call: assert(world.remove_chunk(1, 0, 0) == 0)
  call: assert(world.chunk_count() == 5)
  call: assert(world.get_block(16, 15, 15) == 0 - 1)
  call: assert(world.occupied_blocks() == 4)
  call: assert(world.create_chunk(1, 0, 0) == 1)
  call: assert(world.create_chunk(1, 0, 0) == 0)
  call: assert(world.get_block(16, 15, 15) == 0)
  call: assert(world.create_chunk(65536, 0, 0) == 0)
  call: assert(world.create_chunk(0 - 65537, 0, 0) == 0)
  print: "PASS: signed chunk coordinates, multi-chunk edits, eviction and validation"
