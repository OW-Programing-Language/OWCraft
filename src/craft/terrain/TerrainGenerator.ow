# Deterministic seeded heightfield terrain, independent of GPU and OW Engine.
# Exactly two vertical chunk layers (cy 0 and 1), with heights from 5..19.
# OW has integer division but no modulo operator. All math is overflow-bounded.
class TerrainGenerator:
  field world
  field catalog
  field seed_value
  field water_level

  fn new(world, catalog, seed int):
    call: assert(seed >= 0, "terrain seed must be nonnegative")
    call: assert(seed <= 1000000, "terrain seed must be <= 1000000")
    set this.world: world
    set this.catalog: catalog
    set this.seed_value: seed
    set this.water_level: 8

  fn seed():
    return: this.seed_value

  # Changing seed would invalidate an already-generated world, so reject it.
  fn set_seed(next_seed int):
    if: next_seed < 0
      return: 0
    if: next_seed > 1000000
      return: 0
    if: this.world.chunk_count() != 0
      return: 0
    set this.seed_value: next_seed
    return: 1

  fn floor_div8(value int):
    set quotient int: value / 8
    if: value < 0
      if: value != quotient * 8
        set quotient: quotient - 1
    return: quotient

  fn positive_mod(value int, divisor int):
    set rem int: value - (value / divisor) * divisor
    if: rem < 0
      set rem: rem + divisor
    return: rem

  # Stable 2D lattice heights. Coordinates and seed bounds keep every
  # intermediate value inside signed 32-bit OW integer arithmetic.
  fn lattice_height(grid_x int, grid_z int):
    set base int: grid_x * 57 + grid_z * 131 + this.seed_value * 31
    set folded int: this.positive_mod(base, 997)
    set mixed int: this.positive_mod(folded * folded + folded * 17 + 41, 997)
    return: 5 + mixed / 71

  # Bilinear interpolation over an 8x8 cell smooths the terrain height.
  # A value of -1 means invalid world coordinates.
  fn height_at(x int, z int):
    if: this.world.valid_world_coordinate(x) == 0
      return: 0 - 1
    if: this.world.valid_world_coordinate(z) == 0
      return: 0 - 1
    set gx int: this.floor_div8(x)
    set gz int: this.floor_div8(z)
    set dx int: x - gx * 8
    set dz int: z - gz * 8
    set h00 int: this.lattice_height(gx, gz)
    set h10 int: this.lattice_height(gx + 1, gz)
    set h01 int: this.lattice_height(gx, gz + 1)
    set h11 int: this.lattice_height(gx + 1, gz + 1)
    set first int: h00 * (8 - dx) + h10 * dx
    set second int: h01 * (8 - dx) + h11 * dx
    return: (first * (8 - dz) + second * dz) / 64

  fn material_at(x int, y int, z int):
    set height int: this.height_at(x, z)
    if: height < 0
      return: 0 - 1
    if: y < 0
      return: 0
    if: y > 31
      return: 0
    if: y > height
      if: y <= this.water_level
        return: this.catalog.id_of("water")
      return: 0
    if: y == height
      return: this.catalog.id_of("grass")
    if: y >= height - 3
      return: this.catalog.id_of("dirt")
    return: this.catalog.id_of("stone")

  # Generate a single unloaded chunk. Never overwrites player edits.
  # Return 1 for a newly generated chunk; 0 for invalid/full/existing.
  fn generate_chunk(cx int, cy int, cz int):
    if: cy < 0
      return: 0
    if: cy > 1
      return: 0
    if: this.world.valid_chunk_coordinate(cx) == 0
      return: 0
    if: this.world.valid_chunk_coordinate(cz) == 0
      return: 0
    if: this.world.chunk_index(cx, cy, cz) >= 0
      return: 0
    # Require the known, stable baseline material IDs before mutation.
    if: this.catalog.id_of("grass") != 1
      return: 0
    if: this.catalog.id_of("dirt") != 2
      return: 0
    if: this.catalog.id_of("stone") != 3
      return: 0
    if: this.catalog.id_of("water") != 5
      return: 0
    if: this.world.create_chunk(cx, cy, cz) == 0
      return: 0
    set chunk: this.world.chunk_at(cx, cy, cz)
    set lx int: 0
    while: lx < 16
      set lz int: 0
      while: lz < 16
        set wx int: cx * 16 + lx
        set wz int: cz * 16 + lz
        set height int: this.height_at(wx, wz)
        set ly int: 0
        while: ly < 16
          set y int: cy * 16 + ly
          set block_id int: 0
          if: y <= height
            if: y == height
              set block_id: 1
            else:
              if: y >= height - 3
                set block_id: 2
              else:
                set block_id: 3
          else:
            if: y <= this.water_level
              set block_id: 5
          if: block_id > 0
            call: chunk.set_block(lx, ly, lz, block_id)
          set ly: ly + 1
        set lz: lz + 1
      set lx: lx + 1
    return: 1

  # Two 16³ chunks form one x/z terrain column, y=0..31.
  # Preflight avoids partially generating a column on capacity errors.
  fn generate_column(cx int, cz int):
    if: this.world.valid_chunk_coordinate(cx) == 0
      return: 0
    if: this.world.valid_chunk_coordinate(cz) == 0
      return: 0
    if: this.world.chunk_index(cx, 0, cz) >= 0
      return: 0
    if: this.world.chunk_index(cx, 1, cz) >= 0
      return: 0
    if: this.world.chunk_count() + 2 > this.world.max_chunks()
      return: 0
    if: this.generate_chunk(cx, 0, cz) == 0
      return: 0
    if: this.generate_chunk(cx, 1, cz) == 0
      return: 0
    return: 1

  # Explicit bounded region generation (not asynchronous streaming).
  # All-or-nothing preflight for capacity, bounds and existing chunks.
  # width/depth are each 1..3; max 18 chunks per call.
  fn generate_region(start_cx int, start_cz int, width int, depth int):
    if: width < 1
      return: 0
    if: width > 3
      return: 0
    if: depth < 1
      return: 0
    if: depth > 3
      return: 0
    if: this.world.valid_chunk_coordinate(start_cx) == 0
      return: 0
    if: this.world.valid_chunk_coordinate(start_cz) == 0
      return: 0
    if: this.world.valid_chunk_coordinate(start_cx + width - 1) == 0
      return: 0
    if: this.world.valid_chunk_coordinate(start_cz + depth - 1) == 0
      return: 0
    if: this.world.chunk_count() + width * depth * 2 > this.world.max_chunks()
      return: 0
    set x int: 0
    while: x < width
      set z int: 0
      while: z < depth
        set cx int: start_cx + x
        set cz int: start_cz + z
        if: this.world.chunk_index(cx, 0, cz) >= 0
          return: 0
        if: this.world.chunk_index(cx, 1, cz) >= 0
          return: 0
        set z: z + 1
      set x: x + 1
    set x: 0
    while: x < width
      set z: 0
      while: z < depth
        if: this.generate_column(start_cx + x, start_cz + z) == 0
          return: 0
        set z: z + 1
      set x: x + 1
    return: 1
