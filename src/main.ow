# OWCraft entry point: interpreter-side headless gameplay bootstrap.
# A visible game window and voxel chunks belong to subsequent milestones.
import "craft/CraftGame.ow"

main:
  set game: new CraftGame()
  call: assert(game.start() == 1, "OWCraft boots with OW Engine and flOW")
  call: assert(game.scene_name() == "overworld")
  call: assert(game.block_catalog().id_of("grass") == 1)
  call: assert(game.set_player_velocity(125.0, 0.0, 0.0) == 1)
  call: assert(game.tick(48) == 3)
  set position: game.player_position()
  print: "OWCraft / overworld: player x=" + position[0]
  print: "blocks registered=" + game.block_catalog().count() + ", ticks=" + game.tick_count()
  call: assert(game.stop() == 1)
